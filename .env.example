# ==============================================================================
# Video Factory Environment Configuration
# Copy to .env and add your API key locally (never commit .env).
# ==============================================================================

# Provider selection: "gemini" | "mock" (video: "veo" | "mock")
VF_TTS_PROVIDER=gemini
VF_IMAGE_PROVIDER=gemini
VF_VIDEO_PROVIDER=veo

# Google AI Studio API key (covers Gemini TTS, Gemini image generation, and Veo video)
GEMINI_API_KEY=

# Optional model & voice overrides
VF_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VF_GEMINI_TTS_VOICE=Charon
VF_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VF_GEMINI_VIDEO_MODEL=veo-3.0-generate-001
