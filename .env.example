# ==============================================================================
# Video Factory Configuration
# Copy to .env and fill in the API keys for the providers you want to use.
# You can mix and match providers independently (gemini, openai, or mock).
# ==============================================================================

# Provider selection: "gemini" | "openai" | "mock"
VF_LLM_PROVIDER=gemini
VF_TTS_PROVIDER=openai
VF_IMAGE_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides (optional — sensible defaults are pre-configured)
VF_GEMINI_LLM_MODEL=gemini-2.5-flash
VF_GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
VF_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VF_GEMINI_TTS_VOICE=Enceladus

VF_OPENAI_LLM_MODEL=gpt-4.1-mini
VF_OPENAI_IMAGE_MODEL=gpt-image-1
VF_OPENAI_TTS_MODEL=gpt-4o-mini-tts
VF_OPENAI_TTS_VOICE=onyx

# Default video & sleep-channel settings
VF_DEFAULT_TARGET_MINUTES=20
VF_WORDS_PER_MINUTE=130
VF_SECONDS_PER_SCENE=40
VF_VIDEO_WIDTH=1920
VF_VIDEO_HEIGHT=1080
VF_VIDEO_FPS=24
VF_AMBIENCE_MODE=brown_noise
VF_AMBIENCE_VOLUME_DB=-28.0
VF_ENABLE_SLEEP_DIMMING=true
VF_DIM_START_FRACTION=0.5
VF_DIM_MAX_DARKEN=0.35

# Storage directory for project runs
VF_RUNS_DIR=runs
